generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  onsale
  offsale
  canceled
  postponed
  rescheduled
  unknown
}

model Artist {
  id       String  @id
  name     String
  url      String?
  imageUrl String
  genre    String?
  subGenre String?
  events   Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id      String  @id
  name    String
  city    String?
  state   String?
  country String?
  address String?
  lat     Float?
  lng     Float?
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id            String  @id
  artistId      String
  venueId       String?
  name          String
  url           String?
  imageUrl      String
  date          String?
  time          String?
  dateTime      String?
  dateTBD       Boolean @default(false)
  timeTBA       Boolean @default(false)
  status        EventStatus @default(unknown)
  priceCurrency String?
  priceMin      Float?
  priceMax      Float?

  artist Artist  @relation(fields: [artistId], references: [id])
  venue  Venue?  @relation(fields: [venueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
